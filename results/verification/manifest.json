        "RefSim-M",
        "RefSim-V",
        "RefSim-W"
      ],
      "components": [
        "arrival",
        "processing",
        "repair",
        "survival",
        "transition"
      ],
      "field_sources": {
        "duration_days": null,
        "warmup_days": null,
        "seeds": "derived from _seed_<seed> directory names"
      },
      "metadata_note": "The shadow CSV format records seed and simulated timestamps but does not serialize the requested evaluation and warm-up durations; those fields therefore remain null."
    }
