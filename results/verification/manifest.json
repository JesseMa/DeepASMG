        "GroundSim": 10,
        "GroundSim-DEC": 10,
        "RefSim-M": 10,
        "RefSim-V": 10,
        "RefSim-W": 10
      },
      "field_sources": {
        "duration_days": "bundle.days, validated against runs_by_sim[*].meta.duration_days",
